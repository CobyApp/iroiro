  label          String?
  recipientName  String   @map("recipient_name")
  recipientPhone String   @map("recipient_phone")
  zipcode        String
  baseAddress    String   @map("base_address")
  detailAddress  String?  @map("detail_address")
  isDefault      Boolean  @default(false) @map("is_default")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@index([accountId, createdAt], map: "account_address_account_created_idx")
  @@map("account_address")
}

model UsedWishlist {
  id        BigInt   @id @default(autoincrement())
  accountId String   @map("account_id") @db.Uuid
  listingId BigInt   @map("listing_id")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([accountId, listingId], map: "used_wishlist_account_listing_unique")
  @@index([listingId], map: "used_wishlist_listing_idx")
  @@index([accountId, createdAt], map: "used_wishlist_account_created_idx")
  @@map("used_wishlist")
}

model Banner {
  id        BigInt    @id @default(autoincrement())
  title     String
  imageKey  String    @map("image_key")
  linkUrl   String    @map("link_url")
  startsAt  DateTime? @map("starts_at") @db.Timestamptz(6)
  endsAt    DateTime? @map("ends_at") @db.Timestamptz(6)
  sortOrder Int       @default(0) @map("sort_order")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@index([sortOrder], map: "banner_sort_order_idx")
  @@map("banner")
}

model Order {
  id             BigInt               @id @default(autoincrement())
  orderNo        String               @map("order_no")
  accountId      String               @map("account_id") @db.Uuid
  status         String
  productAmount  Int                  @map("product_amount")
  discountAmount Int                  @map("discount_amount")
  deliveryAmount Int                  @map("delivery_amount")
  totalAmount    Int                  @map("total_amount")
  createdAt      DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime             @default(now()) @map("updated_at") @db.Timestamptz(6)
  items          OrderItem[]
  address        OrderAddress?
  payments       Payment[]
  statusHistory  OrderStatusHistory[]

  @@unique([orderNo], map: "order_order_no_unique")
  @@index([accountId, createdAt], map: "order_account_created_at_idx")
  @@index([status], map: "order_status_idx")
  @@index([createdAt], map: "order_created_at_idx")
  @@index([updatedAt], map: "order_updated_at_idx")
  @@map("order")
}

model OrderNoSeq {
  id        BigInt   @id @default(autoincrement())
  seqDate   DateTime @map("seq_date") @db.Date
  seq       BigInt
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@unique([seqDate], map: "order_no_seq_date_unique")
  @@map("order_no_seq")
}

model OrderItem {
  id                  BigInt   @id @default(autoincrement())
  orderId             BigInt   @map("order_id")
  productId           BigInt   @map("product_id")
  productName         String   @map("product_name")
  productThumbnailKey String?  @map("product_thumbnail_key")
  itemType            String   @map("item_type")
  condition           String?
  unitPrice           Int      @map("unit_price")
  quantity            Int
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  order               Order    @relation(fields: [orderId], references: [id])

  @@index([orderId], map: "order_item_order_idx")
  @@index([productId], map: "order_item_product_idx")
  @@index([createdAt], map: "order_item_created_at_idx")
  @@map("order_item")
}

model OrderAddress {
  id              BigInt   @id @default(autoincrement())
  orderId         BigInt   @map("order_id")
  accountId       String   @map("account_id") @db.Uuid
  recipientName   String   @map("recipient_name")
  recipientPhone  String   @map("recipient_phone")
  zipcode         String
  baseAddress     String   @map("base_address")
  detailAddress   String?  @map("detail_address")
  deliveryMessage String?  @map("delivery_message")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  order           Order    @relation(fields: [orderId], references: [id])

  @@unique([orderId], map: "order_address_order_unique")
  @@index([accountId], map: "order_address_account_idx")
  @@index([createdAt], map: "order_address_created_at_idx")
  @@map("order_address")
}

model Payment {
  id              BigInt    @id @default(autoincrement())
  orderId         BigInt    @map("order_id")
  accountId       String    @map("account_id") @db.Uuid
  orderNo         String    @map("order_no")
  provider        String
  method          String?
  status          String
  requestedAmount Int       @map("requested_amount")
  approvedAmount  Int?      @map("approved_amount")
  tradeNo         String?   @map("trade_no")
  approvedAt      DateTime? @map("approved_at") @db.Timestamptz(6)
  canceledAt      DateTime? @map("canceled_at") @db.Timestamptz(6)
  failMessage     String?   @map("fail_message")
  rawRequest      Json?     @map("raw_request")
  rawResponse     Json?     @map("raw_response")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  order           Order     @relation(fields: [orderId], references: [id])

  @@unique([tradeNo], map: "payment_trade_no_unique", where: raw("(trade_no IS NOT NULL)"))
  @@unique([orderId], map: "payment_order_unique")
  @@index([accountId], map: "payment_account_idx")
  @@index([orderNo], map: "payment_order_no_idx")
  @@index([status], map: "payment_status_idx")
  @@index([createdAt], map: "payment_created_at_idx")
  @@index([updatedAt], map: "payment_updated_at_idx")
  @@map("payment")
}

model OrderStatusHistory {
  id              BigInt   @id @default(autoincrement())
  orderId         BigInt   @map("order_id")
  status          String
  statusChangedAt DateTime @map("status_changed_at") @db.Timestamptz(6)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  order           Order    @relation(fields: [orderId], references: [id])

  @@index([orderId, statusChangedAt], map: "order_status_history_order_idx")
  @@index([createdAt], map: "order_status_history_created_at_idx")
  @@map("order_status_history")
}

// 배송비 정책 — 항상 1행(singleton, DB CHECK id=1). 어드민이 값만 수정.
model DeliveryPolicy {
  id                  BigInt   @id
  deliveryFee         Int      @map("delivery_fee")
  freeThresholdAmount Int?     @map("free_threshold_amount")
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@map("delivery_policy")
}

// ── 카드 컬렉션 도메인: 보유 원장 + 전시 컬렉션 (init_collection 마이그레이션이 단일 진실) ──
// 컬렉션 도메인 내부만 관계 선언. account_id/product_id/order_id/order_item_id/team_id/
// member_id는 bare 스칼라(교차 도메인). RLS 미적용 — 인가는 앱 DAL(accountId 스코프).
model Collection {
  id         BigInt           @id @default(autoincrement())
  accountId  String           @map("account_id") @db.Uuid
  publicCode String           @map("public_code")
  title      String
  isPublic   Boolean          @default(false) @map("is_public")
  sortOrder  Int              @map("sort_order")
  createdAt  DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime         @default(now()) @map("updated_at") @db.Timestamptz(6)
  items      CollectionItem[]

  @@unique([publicCode], map: "collection_public_code_unique")
  @@index([accountId, sortOrder], map: "collection_account_sort_order_idx")
  @@index([createdAt], map: "collection_created_at_idx")
  @@index([updatedAt], map: "collection_updated_at_idx")
  @@map("collection")
}

model CollectionItem {
  id           BigInt     @id @default(autoincrement())
  collectionId BigInt     @map("collection_id")
  productId    BigInt     @map("product_id")
  sortOrder    Int        @map("sort_order")
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime   @default(now()) @map("updated_at") @db.Timestamptz(6)
  collection   Collection @relation(fields: [collectionId], references: [id])

  @@unique([collectionId, productId], map: "collection_item_collection_product_unique")
  @@index([collectionId, sortOrder], map: "collection_item_collection_sort_order_idx")
  @@index([productId], map: "collection_item_product_idx")
  @@index([createdAt], map: "collection_item_created_at_idx")
  @@index([updatedAt], map: "collection_item_updated_at_idx")
  @@map("collection_item")
}

model InventoryItem {
  id                  BigInt    @id @default(autoincrement())
  accountId           String    @map("account_id") @db.Uuid
  productId           BigInt    @map("product_id")
  orderItemId         BigInt    @map("order_item_id")
  productName         String    @map("product_name")
  productThumbnailKey String?   @map("product_thumbnail_key")
  itemType            String    @map("item_type")
  teamId              BigInt?   @map("team_id")
  memberId            BigInt?   @map("member_id")
  quantity            Int
  acquiredAt          DateTime  @map("acquired_at") @db.Timestamptz(6)
  reversedAt          DateTime? @map("reversed_at") @db.Timestamptz(6)
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@unique([orderItemId], map: "inventory_item_order_item_unique")
  @@index([accountId, productId], map: "inventory_item_account_product_idx")
  @@index([createdAt], map: "inventory_item_created_at_idx")
  @@index([updatedAt], map: "inventory_item_updated_at_idx")
  @@map("inventory_item")
}

// ── 카탈로그 시리즈 (그룹→멤버→종류→시리즈 계층의 최하위) ─────────────────────
// 외부 분석기 sku가 단일 진실 — 임포트 시 find-or-create로 자동 생성.
// ── 사이트 전역 설정 — 항상 1행(singleton, DB CHECK id=1) ────────────────────
model SiteSetting {
  id               BigInt   @id
  usedTradeEnabled Boolean  @default(false) @map("used_trade_enabled")
  usedTradeFeeBp   Int      @default(1000) @map("used_trade_fee_bp")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@map("site_setting")
}

// ── 중고거래 (C2C) — 유저 등록 매물·사진·입찰·거래 ────────────────────────────
model UsedListing {
  id                     BigInt    @id @default(autoincrement())
  sellerAccountId        String    @map("seller_account_id") @db.Uuid
  itemType               String    @default("photocard") @map("item_type")
  cardId                 BigInt?   @map("card_id")
  teamId                 BigInt?   @map("team_id")
  memberId               BigInt?   @map("member_id")
  seriesId               BigInt?   @map("series_id")
  sourceProductId        BigInt?   @map("source_product_id")
  title                  String
  description            String?
  condition              String
  saleMode               String    @default("fixed") @map("sale_mode")
  price                  Int?
  shippingMethod         String    @default("post") @map("shipping_method")
  shippingFee            Int       @default(0) @map("shipping_fee")
  status                 String    @default("active")
  auctionStartPrice      Int?      @map("auction_start_price")
  auctionCurrentPrice    Int?      @map("auction_current_price")
  auctionBidCount        Int       @default(0) @map("auction_bid_count")
  auctionEndsAt          DateTime? @map("auction_ends_at") @db.Timestamptz(6)
  auctionStatus          String?   @map("auction_status")
  auctionWinnerAccountId String?   @map("auction_winner_account_id") @db.Uuid
  auctionPayDueAt        DateTime? @map("auction_pay_due_at") @db.Timestamptz(6)
  viewCount              Int       @default(0) @map("view_count")
  createdAt              DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  photos                 UsedListingPhoto[]

  @@index([status, createdAt(sort: Desc)], map: "used_listing_status_created_idx")
  @@index([sellerAccountId, createdAt(sort: Desc)], map: "used_listing_seller_idx")
  @@index([seriesId], map: "used_listing_series_idx")
  @@index([memberId], map: "used_listing_member_idx")
  @@index([auctionStatus, auctionEndsAt], map: "used_listing_auction_due_idx")
  @@index([cardId], map: "used_listing_card_idx")
  @@map("used_listing")
}

model UsedListingPhoto {
  id           BigInt      @id @default(autoincrement())
  listingId    BigInt      @map("listing_id")
  r2Key        String      @map("r2_key")
  displayOrder Int         @default(0) @map("display_order")
  isPrimary    Boolean     @default(false) @map("is_primary")
  createdAt    DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  listing      UsedListing @relation(fields: [listingId], references: [id])

  @@unique([listingId], map: "used_listing_photo_primary_unique", where: raw("(is_primary = true)"))
  @@index([listingId, displayOrder], map: "used_listing_photo_listing_idx")
  @@map("used_listing_photo")
}

model UsedBid {
  id        BigInt   @id @default(autoincrement())
  listingId BigInt   @map("listing_id")
  accountId String   @map("account_id") @db.Uuid
  amount    Int
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([listingId, amount(sort: Desc), id], map: "used_bid_listing_idx")
  @@index([accountId, createdAt(sort: Desc)], map: "used_bid_account_idx")
  @@map("used_bid")
}

model UsedTrade {
  id               BigInt    @id @default(autoincrement())
  listingId        BigInt    @map("listing_id")
  buyerAccountId   String    @map("buyer_account_id") @db.Uuid
  sellerAccountId  String    @map("seller_account_id") @db.Uuid
  price            Int
  shippingFee      Int       @default(0) @map("shipping_fee")
  feeBp            Int       @map("fee_bp")
  feeAmount        Int       @map("fee_amount")
  sellerPayout     Int       @map("seller_payout")
  status           String    @default("pending")
  bundleId         BigInt?   @map("bundle_id")
  recipientName    String?   @map("recipient_name")
  recipientPhone   String?   @map("recipient_phone")
  recipientAddress String?   @map("recipient_address")
  postTrackingCode String?   @map("post_tracking_code")
  postQrIssuedAt   DateTime? @map("post_qr_issued_at") @db.Timestamptz(6)
  completedAt      DateTime? @map("completed_at") @db.Timestamptz(6)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@unique([listingId], map: "used_trade_listing_unique", where: raw("(status <> 'canceled')"))
  @@index([buyerAccountId, createdAt(sort: Desc)], map: "used_trade_buyer_idx")
  @@index([sellerAccountId, createdAt(sort: Desc)], map: "used_trade_seller_idx")
  @@index([status, createdAt(sort: Desc)], map: "used_trade_status_idx")
  @@index([bundleId], map: "used_trade_bundle_idx")
  @@map("used_trade")
}

model UsedBundle {
  id               BigInt    @id @default(autoincrement())
  buyerAccountId   String    @map("buyer_account_id") @db.Uuid
  sellerAccountId  String    @map("seller_account_id") @db.Uuid
  itemTotal        Int       @map("item_total")
  shippingFee      Int       @default(0) @map("shipping_fee")
  pointsUsed       Int       @default(0) @map("points_used")
  feeAmount        Int       @default(0) @map("fee_amount")
  sellerPayout     Int       @default(0) @map("seller_payout")
  status           String    @default("paid")
  recipientName    String?   @map("recipient_name")
  recipientPhone   String?   @map("recipient_phone")
  recipientAddress String?   @map("recipient_address")
  postTrackingCode String?   @map("post_tracking_code")
  postQrIssuedAt   DateTime? @map("post_qr_issued_at") @db.Timestamptz(6)
  completedAt      DateTime? @map("completed_at") @db.Timestamptz(6)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@index([buyerAccountId, createdAt(sort: Desc)], map: "used_bundle_buyer_idx")
  @@index([sellerAccountId, createdAt(sort: Desc)], map: "used_bundle_seller_idx")
  @@map("used_bundle")
}
