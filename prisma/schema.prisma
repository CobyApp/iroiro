// Prisma schema — db/schema.sql이 단일 진실 소스.
// `npm run db:pull`로 introspect 후 수동으로 camelCase 매핑 유지.
// Prisma는 @map/@@map을 db pull에서도 보존한다.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider     = "postgresql"
  relationMode = "prisma"
}

model Product {
  id                   BigInt   @id @default(autoincrement())
  itemCode             String?  @map("item_code")
  itemType             String   @map("item_type")
  teamId               BigInt?  @map("team_id")
  memberId             BigInt?  @map("member_id")
  name                 String
  description          String?
  purchasePriceJpy     Int      @map("purchase_price_jpy")
  purchaseExchangeRate Decimal  @map("purchase_exchange_rate") @db.Decimal(8, 4)
  purchasePriceKrw     Int      @map("purchase_price_krw")
  packagingCostKrw     Int      @default(0) @map("packaging_cost_krw")
  overseasShippingKrw  Int      @default(0) @map("overseas_shipping_krw")
  domesticShippingKrw  Int      @default(0) @map("domestic_shipping_krw")
  otherCostKrw         Int      @default(0) @map("other_cost_krw")
  purchaser            String?  @map("purchaser")
  purchaseDate         DateTime @map("purchase_date") @db.Date
  regularPrice         Int      @map("regular_price")
  salePrice            Int      @map("sale_price")
  condition            String?
  stockQuantity        Int      @default(0) @map("stock_quantity")
  saleStatus           String   @map("sale_status")
  // ── 카탈로그 계층·외부 시세 (임포트 시 스냅샷) ──
  seriesId             BigInt?  @map("series_id")
  marketAvgJpy         Int      @default(0) @map("market_avg_jpy")
  marketMinJpy         Int      @default(0) @map("market_min_jpy")
  marketMaxJpy         Int      @default(0) @map("market_max_jpy")
  marketSoldCount      Int      @default(0) @map("market_sold_count")
  retailPriceJpy       Int      @default(0) @map("retail_price_jpy")
  // ── 입찰 경매 (sale_mode='auction'일 때만 의미) ──
  saleMode               String    @default("fixed") @map("sale_mode")
  auctionStartPrice      Int?      @map("auction_start_price")
  auctionCurrentPrice    Int?      @map("auction_current_price")
  auctionBidCount        Int       @default(0) @map("auction_bid_count")
  auctionEndsAt          DateTime? @map("auction_ends_at") @db.Timestamptz(6)
  auctionStatus          String?   @map("auction_status")
  auctionWinnerAccountId String?   @map("auction_winner_account_id") @db.Uuid
  auctionPayDueAt        DateTime? @map("auction_pay_due_at") @db.Timestamptz(6)
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy            String?  @map("created_by")
  updatedAt            DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  updatedBy            String?  @map("updated_by")

  @@index([itemCode, itemType, condition], map: "product_item_code_idx", where: raw("(item_code IS NOT NULL)"))
  @@index([saleStatus, createdAt], map: "product_sale_status_created_at_idx")
  @@index([saleStatus, itemType], map: "product_sale_status_item_type_idx")
  @@index([saleStatus, memberId], map: "product_sale_status_member_idx")
  @@index([saleStatus, teamId], map: "product_sale_status_team_idx")
  @@index([createdAt], map: "product_created_at_idx")
  @@index([updatedAt], map: "product_updated_at_idx")
  @@index([salePrice], map: "product_sale_price_idx")
  @@index([seriesId], map: "product_series_idx")
  @@map("product")
}

// 인앱 알림 — 입찰·주문/배송 이벤트. FK 없음(data-modeling.md 정책).
model Notification {
  id        BigInt    @id @default(autoincrement())
  accountId String    @map("account_id") @db.Uuid
  type      String
  title     String
  body      String?
  linkPath  String?   @map("link_path")
  readAt    DateTime? @map("read_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([accountId, createdAt(sort: Desc)], map: "notification_account_idx")
  @@map("notification")
}

// 1:1 쪽지 스레드 — pair당 1개. a_account_id < b_account_id로 정규화. FK 없음(정책).
model MessageThread {
  id            BigInt    @id @default(autoincrement())
  aAccountId    String    @map("a_account_id") @db.Uuid
  bAccountId    String    @map("b_account_id") @db.Uuid
  aLastReadAt   DateTime? @map("a_last_read_at") @db.Timestamptz(6)
  bLastReadAt   DateTime? @map("b_last_read_at") @db.Timestamptz(6)
  lastMessageAt DateTime  @default(now()) @map("last_message_at") @db.Timestamptz(6)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([aAccountId, bAccountId], map: "message_thread_pair_unique")
  @@index([aAccountId, lastMessageAt(sort: Desc)], map: "message_thread_a_idx")
  @@index([bAccountId, lastMessageAt(sort: Desc)], map: "message_thread_b_idx")
  @@map("message_thread")
}

// 쪽지 메시지 — append-only. FK 없음(정책).
model Message {
  id              BigInt   @id @default(autoincrement())
  threadId        BigInt   @map("thread_id")
  senderAccountId String   @map("sender_account_id") @db.Uuid
  body            String
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([threadId, createdAt], map: "message_thread_created_idx")
  @@index([senderAccountId, createdAt], map: "message_sender_created_idx")
  @@map("message")
}

// 포인트 원장 — append-only, 잔액 = SUM(amount). FK 없음(정책).
model PointTransaction {
  id        BigInt   @id @default(autoincrement())
  accountId String   @map("account_id") @db.Uuid
  amount    Int
  reason    String
  orderId   BigInt?  @map("order_id")
  /** 리뷰 적립의 대상 상품 — reason='review'일 때만 사용. */
  productId BigInt?  @map("product_id")
  memo      String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([accountId, createdAt(sort: Desc)], map: "point_tx_account_idx")
  @@map("point_transaction")
}

// 계정 보유 쿠폰 — v1은 무료배송(free_shipping)만. FK 없음(정책).
model AccountCoupon {
  id           BigInt    @id @default(autoincrement())
  accountId    String    @map("account_id") @db.Uuid
  kind         String
  issuedReason String    @map("issued_reason")
  expiresAt    DateTime? @map("expires_at") @db.Timestamptz(6)
  usedAt       DateTime? @map("used_at") @db.Timestamptz(6)
  usedOrderId  BigInt?   @map("used_order_id")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([accountId, usedAt, kind], map: "account_coupon_account_idx")
  @@map("account_coupon")
}

// 도착 인증 리뷰 — 배송된 주문의 구매자만, 주문·상품·계정 조합당 1건. FK 없음(정책).
model ProductReview {
  id        BigInt   @id @default(autoincrement())
  productId BigInt   @map("product_id")
  orderId   BigInt   @map("order_id")
  accountId String   @map("account_id") @db.Uuid
  rating    Int      @db.SmallInt
  body      String   @default("")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@unique([orderId, productId, accountId], map: "product_review_once_per_order")
  @@index([productId, createdAt(sort: Desc)], map: "product_review_product_idx")
  @@index([accountId], map: "product_review_account_idx")
  @@map("product_review")
}

// 친구 초대 — 초대 코드는 account.public_code 재사용, 피초대자당 1건. FK 없음(정책).
model Referral {
  id               BigInt   @id @default(autoincrement())
  inviterAccountId String   @map("inviter_account_id") @db.Uuid
  inviteeAccountId String   @unique(map: "referral_invitee_once") @map("invitee_account_id") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([inviterAccountId, createdAt(sort: Desc)], map: "referral_inviter_idx")
  @@map("referral")
}

// 최애 그룹·멤버 — 가입/회원정보 복수 선택, 홈 추천용. FK 없음(정책).
model AccountFavorite {
  id        BigInt   @id @default(autoincrement())
  accountId String   @map("account_id") @db.Uuid
  kind      String
  targetId  BigInt   @map("target_id")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([accountId, kind, targetId], map: "account_favorite_uq")
  @@index([accountId], map: "account_favorite_account_idx")
  @@map("account_favorite")
}

// 웹 푸시 구독(기기별) — endpoint 고유. FK 없음(data-modeling.md 정책).
model PushSubscription {
  id        BigInt   @id @default(autoincrement())
  accountId String   @map("account_id") @db.Uuid
  endpoint  String   @unique(map: "push_subscription_endpoint_uq")
  p256dh    String
  auth      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([accountId], map: "push_subscription_account_idx")
  @@map("push_subscription")
}

// 경매 입찰 원장 — 취소 불가(append-only). FK 없음(data-modeling.md 정책).
model AuctionBid {
  id        BigInt   @id @default(autoincrement())
  productId BigInt   @map("product_id")
  accountId String   @map("account_id") @db.Uuid
  amount    Int
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([productId, amount(sort: Desc), id], map: "auction_bid_product_idx")
  @@index([accountId, createdAt(sort: Desc)], map: "auction_bid_account_idx")
  @@map("auction_bid")
}

model ProductPhoto {
  id           BigInt   @id @default(autoincrement())
  productId    BigInt   @map("product_id")
  r2Key        String   @map("r2_key")
  altText      String?  @map("alt_text")
  displayOrder Int      @default(0) @map("display_order")
  isThumbnail  Boolean  @default(false) @map("is_thumbnail")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy    String?  @map("created_by")
  updatedAt    DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  updatedBy    String?  @map("updated_by")

  @@unique([productId], map: "product_photo_one_thumbnail_unique", where: raw("(is_thumbnail = true)"))
  @@index([productId, displayOrder], map: "product_photo_product_idx")
  @@index([createdAt], map: "product_photo_created_at_idx")
  @@index([updatedAt], map: "product_photo_updated_at_idx")
  @@map("product_photo")
}

// ── 회원·자체 인증 (init_account 마이그레이션이 단일 진실) ─────────────────────
model Account {
  id                    String            @id @db.Uuid // 앱 생성 UUIDv7 (DB default 없음)
  email                 String?
  emailVerifiedAt       DateTime?         @map("email_verified_at") @db.Timestamptz(6)
  phoneNumber           String?           @map("phone_number")
  phoneNumberVerifiedAt DateTime?         @map("phone_number_verified_at") @db.Timestamptz(6)
  displayName           String            @map("display_name")
  publicCode            String            @map("public_code") // 공개 작성자 코드 (Base58 8자)
  avatarKey             String?           @map("avatar_key")
  deletedAt             DateTime?         @map("deleted_at") @db.Timestamptz(6)
  isAdmin               Boolean           @default(false) @map("is_admin")
  boardRole             String            @default("member") @map("board_role")
  postingBannedAt       DateTime?         @map("posting_banned_at") @db.Timestamptz(6)
  postingBanReason      String?           @map("posting_ban_reason")
  createdAt             DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime          @default(now()) @map("updated_at") @db.Timestamptz(6)
  identities            AccountIdentity[]
  sessions              AccountSession[]

  @@unique([phoneNumber], map: "account_phone_number_verified_uq", where: raw("(phone_number_verified_at IS NOT NULL)"))
  @@unique([publicCode], map: "account_public_code_unique")
  @@index([email], map: "account_email_idx", where: raw("(email IS NOT NULL)"))
  @@index([createdAt], map: "account_created_at_idx")
  @@index([updatedAt], map: "account_updated_at_idx")
  @@map("account")
}

model AccountIdentity {
  id             BigInt   @id @default(autoincrement())
  accountId      String   @map("account_id") @db.Uuid
  provider       String // 'kakao' | 'naver'
  providerUserId String   @map("provider_user_id")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  account        Account  @relation(fields: [accountId], references: [id])

  @@unique([provider, providerUserId], map: "account_identity_provider_uq")
  @@index([accountId], map: "account_identity_account_idx")
  @@index([createdAt], map: "account_identity_created_at_idx")
  @@map("account_identity")
}

model AccountSession {
  tokenHash String   @id @map("token_hash") // 세션 토큰의 SHA-256 해시
  accountId String   @map("account_id") @db.Uuid
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  account   Account  @relation(fields: [accountId], references: [id])

  @@index([accountId], map: "account_session_account_idx")
  @@index([expiresAt], map: "account_session_expires_idx")
  @@index([createdAt], map: "account_session_created_at_idx")
  @@map("account_session")
}

model PendingAccount {
  tokenHash      String   @id @map("token_hash") // 가입 토큰 해시
  provider       String
  providerUserId String   @map("provider_user_id")
  email          String?
  displayName    String?  @map("display_name")
  expiresAt      DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([expiresAt], map: "pending_account_expires_idx")
  @@index([createdAt], map: "pending_account_created_at_idx")
  @@map("pending_account")
}

// ── 공지사항 (init_notice 마이그레이션이 단일 진실) ──
model Notice {
  id         BigInt        @id @default(autoincrement())
  publicCode String        @map("public_code")
  category   String        @default("general") // 'general' | 'event' — 앱 zod 검증
  title      String
  body       String
  isPinned   Boolean       @default(false) @map("is_pinned")
  deletedAt  DateTime?     @map("deleted_at") @db.Timestamptz(6)
  createdAt  DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy  String?       @map("created_by")
  updatedAt  DateTime      @default(now()) @map("updated_at") @db.Timestamptz(6)
  updatedBy  String?       @map("updated_by")
  photos     NoticePhoto[]

  @@unique([publicCode], map: "notice_public_code_unique")
  @@index([createdAt], map: "notice_created_at_idx")
  @@index([updatedAt], map: "notice_updated_at_idx")
  @@map("notice")
}

model NoticePhoto {
  id           BigInt   @id @default(autoincrement())
  noticeId     BigInt   @map("notice_id")
  r2Key        String   @map("r2_key")
  displayOrder Int      @default(0) @map("display_order")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  notice       Notice   @relation(fields: [noticeId], references: [id])

  @@unique([r2Key], map: "notice_photo_r2_key_unique")
  @@index([noticeId, displayOrder], map: "notice_photo_notice_id_idx")
  @@index([createdAt], map: "notice_photo_created_at_idx")
  @@map("notice_photo")
}

// ── 자유게시판 (init_post 마이그레이션이 단일 진실) ──
model Post {
  id           BigInt         @id @default(autoincrement())
  accountId    String         @map("account_id") @db.Uuid
  publicCode   String         @map("public_code")
  topic        String
  title        String
  body         String
  teamId       BigInt?        @map("team_id")
  memberId     BigInt?        @map("member_id")
  cardId       BigInt?        @map("card_id")
  linkUrl      String?        @map("link_url")
  linkLabel    String?        @map("link_label")
  eventStartsAt DateTime?     @map("event_starts_at") @db.Timestamptz(6)
  eventEndsAt  DateTime?      @map("event_ends_at") @db.Timestamptz(6)
  eventPlace   String?        @map("event_place")
  editedAt     DateTime?      @map("edited_at") @db.Timestamptz(6)
  hiddenAt     DateTime?      @map("hidden_at") @db.Timestamptz(6)
  hiddenReason String?        @map("hidden_reason")
  hiddenBy     String?        @map("hidden_by")
  deletedAt    DateTime?      @map("deleted_at") @db.Timestamptz(6)
  createdAt    DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime       @default(now()) @map("updated_at") @db.Timestamptz(6)
  comments     PostComment[]
  photos       PostPhoto[]

  @@unique([publicCode], map: "post_public_code_unique")
  @@index([accountId, createdAt], map: "post_account_created_at_idx")
  @@index([createdAt], map: "post_created_at_idx")
  @@index([updatedAt], map: "post_updated_at_idx")
  @@index([eventStartsAt], map: "post_event_starts_at_idx")
  @@index([teamId], map: "post_team_idx")
  @@index([memberId], map: "post_member_idx")
  @@index([cardId], map: "post_card_idx")
  @@map("post")
}

model PostComment {
  id           BigInt    @id @default(autoincrement())
  postId       BigInt    @map("post_id")
  accountId    String    @map("account_id") @db.Uuid
  parentId     BigInt?   @map("parent_id")
  body         String
  hiddenAt     DateTime? @map("hidden_at") @db.Timestamptz(6)
  hiddenReason String?   @map("hidden_reason")
  hiddenBy     String?   @map("hidden_by")
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz(6)
  editedAt     DateTime? @map("edited_at") @db.Timestamptz(6) // 본문 편집 시각 (수정됨 표시 전용)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  post         Post      @relation(fields: [postId], references: [id])

  @@index([postId], map: "post_comment_post_idx")
  @@index([parentId], map: "post_comment_parent_idx")
  @@index([accountId, createdAt], map: "post_comment_account_created_at_idx")
  @@index([createdAt], map: "post_comment_created_at_idx")
  @@index([updatedAt], map: "post_comment_updated_at_idx")
  @@map("post_comment")
}

model PostReport {
  id                BigInt    @id @default(autoincrement())
  postId            BigInt    @map("post_id")
  reporterAccountId String    @map("reporter_account_id") @db.Uuid
  reason            String
  detail            String?
  snapshot          Json
  resolution        String?
  resolvedBy        String?   @map("resolved_by")
  resolutionNote    String?   @map("resolution_note")
  resolvedAt        DateTime? @map("resolved_at") @db.Timestamptz(6)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@unique([postId, reporterAccountId], map: "post_report_post_reporter_unique")
  @@index([reporterAccountId, createdAt], map: "post_report_reporter_created_at_idx")
  @@index([createdAt], map: "post_report_unresolved_created_at_idx", where: raw("(resolved_at IS NULL)"))
  @@index([createdAt], map: "post_report_created_at_idx")
  @@index([updatedAt], map: "post_report_updated_at_idx")
  @@map("post_report")
}

model PostCommentReport {
  id                BigInt    @id @default(autoincrement())
  commentId         BigInt    @map("comment_id")
  reporterAccountId String    @map("reporter_account_id") @db.Uuid
  reason            String
  detail            String?
  snapshot          Json
  resolution        String?
  resolvedBy        String?   @map("resolved_by")
  resolutionNote    String?   @map("resolution_note")
  resolvedAt        DateTime? @map("resolved_at") @db.Timestamptz(6)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@unique([commentId, reporterAccountId], map: "post_comment_report_comment_reporter_unique")
  @@index([reporterAccountId, createdAt], map: "post_comment_report_reporter_created_at_idx")
  @@index([createdAt], map: "post_comment_report_unresolved_created_at_idx", where: raw("(resolved_at IS NULL)"))
  @@index([createdAt], map: "post_comment_report_created_at_idx")
  @@index([updatedAt], map: "post_comment_report_updated_at_idx")
  @@map("post_comment_report")
}

model PostPhoto {
  id           BigInt    @id @default(autoincrement())
  postId       BigInt    @map("post_id")
  r2Key        String    @map("r2_key")
  displayOrder Int       @default(0) @map("display_order")
  isThumbnail  Boolean   @default(false) @map("is_thumbnail")
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  post         Post      @relation(fields: [postId], references: [id])

  @@unique([r2Key], map: "post_photo_r2_key_unique")
  @@unique([postId], map: "post_photo_one_thumbnail_unique", where: raw("(is_thumbnail = true AND deleted_at IS NULL)"))
  @@index([postId, displayOrder], map: "post_photo_post_idx")
  @@index([createdAt], map: "post_photo_created_at_idx")
  @@index([updatedAt], map: "post_photo_updated_at_idx")
  @@map("post_photo")
}

model PendingPostPhoto {
  id          BigInt    @id @default(autoincrement())
  accountId   String    @map("account_id") @db.Uuid
  r2Key       String    @map("r2_key")
  contentType String    @map("content_type")
  sizeBytes   Int       @map("size_bytes")
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz(6)
  consumedAt  DateTime? @map("consumed_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@unique([r2Key], map: "pending_post_photo_r2_key_unique")
  @@index([accountId, createdAt], map: "pending_post_photo_account_created_at_idx")
  @@index([expiresAt], map: "pending_post_photo_expires_at_idx")
  @@index([createdAt], map: "pending_post_photo_created_at_idx")
  @@index([updatedAt], map: "pending_post_photo_updated_at_idx")
  @@map("pending_post_photo")
}

// ── 장바구니·주문·결제(mock) (init_order 마이그레이션이 단일 진실) ───────────────
// 주문 도메인 내부만 관계 선언. account_id/product_id는 bare 스칼라(교차 도메인,
// product_photo 선례) + 자식 테이블에 account_id 비정규화로 owner-RLS 단순화.
model CartItem {
  id        BigInt   @id @default(autoincrement())
  accountId String   @map("account_id") @db.Uuid
  productId BigInt   @map("product_id")
  quantity  Int
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@unique([accountId, productId], map: "cart_item_account_product_unique")
  @@index([productId], map: "cart_item_product_idx")
  @@index([createdAt], map: "cart_item_created_at_idx")
  @@index([updatedAt], map: "cart_item_updated_at_idx")
  @@map("cart_item")
}

model Wishlist {
  id        BigInt   @id @default(autoincrement())
  accountId String   @map("account_id") @db.Uuid
  productId BigInt   @map("product_id")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([accountId, productId], map: "wishlist_account_product_unique")
  @@index([productId], map: "wishlist_product_idx")
  @@index([accountId, createdAt], map: "wishlist_account_created_idx")
  @@map("wishlist")
}

model AccountAddress {
