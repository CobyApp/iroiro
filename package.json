{
  "name": "iroiro",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "postinstall": "test -f .env.local || cp .env.local.example .env.local",
    "dev": "next dev",
    "dev:all": "npm run services:up && next dev",
    "services:up": "docker compose up -d --wait",
    "services:down": "docker compose down -v",
    "services:status": "docker compose ps",
    "db:reset": "sh scripts/db-reset.sh",
    "db:pull": "dotenv -e .env.local -- prisma db pull",
    "db:generate": "dotenv -e .env.local -- prisma generate",
    "db:studio": "dotenv -e .env.local -- prisma studio",
    "build": "prisma generate && next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "validate": "npm run lint && npm run typecheck && npm run test",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "dotenv -e .env.local -v RUN_INTEGRATION=1 -- vitest run tests/integration",
    "minio:up": "docker compose up -d",
    "minio:down": "docker compose down",
    "minio:reset": "docker compose down -v && docker compose up -d",
    "prepare": "husky",
    "secretlint": "secretlint --secretlintignore .gitignore '**/*'",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "lint-staged": {
    "*": [
      "secretlint"
    ],
    "**/*.{ts,tsx,mts}": [
      "vitest related --run --reporter=dot"
    ]
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@types/archiver": "^7.0.0",
    "archiver": "^7.0.1",
    "aws4fetch": "^1.0.20",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "embla-carousel-react": "^8.6.0",
    "lucide-react": "^1.14.0",
    "next": "16.2.4",
    "next-themes": "^0.4.6",
    "pg": "^8.20.0",
    "prisma": "^7.8.0",
    "react": "19.2.4",
    "react-day-picker": "^10.0.0",
    "react-dom": "19.2.4",
    "server-only": "^0.0.1",
    "sharp": "^0.35.3",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "uuid": "^14.0.0",
    "web-push": "^3.6.7",
    "yet-another-react-lightbox": "^3.32.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@secretlint/secretlint-rule-preset-recommend": "^13.0.0",
    "@storybook/addon-a11y": "^10.5.3",
    "@storybook/react-vite": "^10.5.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "^6.0.1",
    "dotenv": "^17.4.2",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "husky": "^9.1.7",
    "jsdom": "^29.1.0",
    "lint-staged": "^17.0.4",
    "secretlint": "^13.0.0",
    "storybook": "^10.5.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.5"
  }
}
