# Phase 1: MinIO local storage
R2_ENDPOINT=http://localhost:9000
R2_ACCESS_KEY_ID=minioadmin
R2_SECRET_ACCESS_KEY=minioadmin
R2_BUCKET=oshikore-products-dev
R2_PUBLIC_BASE=http://localhost:9000/oshikore-products-dev
# UGC 사진 전용 비공개 버킷 — 공개 도메인 연결 금지(서명 GET만으로 서빙)
# 자격증명은 위 R2_*를 공유한다 — 운영 토큰 스코프에 이 버킷도 포함할 것
R2_UGC_BUCKET=oshikore-ugc-dev

# 결제 게이트웨이 어댑터 (기본 mock). 실 PG 연동 시 "toss" 등으로 교체 + 해당 시크릿 추가.
PAYMENT_PROVIDER=mock

# Supabase (로컬값은 모든 로컬 환경에서 동일 — supabase start 출력 그대로)
# Production 배포 시엔 Supabase Cloud 프로젝트의 고유값으로 교체
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_ACJWlzQHlZjBrEguHvfOxg_3BJgxAaH
SUPABASE_SECRET_KEY=sb_secret_N7UND0UgjKTVK-Uodkm0Hg_xSvEMPvz

# Prisma 직접 연결 — 비특권 `app` 롤로 접속한다(GRANT 매트릭스가 DB 방어선).
#   소유자 postgres로 붙으면 GRANT가 무효라 soft delete 강제 등이 작동하지 않는다.
# 로컬: seed.sql이 app 롤에 LOGIN을 자동 부여한다 → 아래 값을 그대로 쓰면 된다
#   postgresql://app:app@127.0.0.1:54322/postgres
# 운영: 각 환경에서 `ALTER ROLE app WITH LOGIN PASSWORD '...'` 1회 실행 후
#   Supabase Cloud Project Settings > Database > Connection string의 호스트에 app 자격 사용
DATABASE_URL=postgresql://app:app@127.0.0.1:54322/postgres

# OAuth 소셜 로그인 (자체 인증 — 카카오·네이버)
# 외부 등록 필요(콘솔에서 Redirect/Callback URI를 아래 경로로 등록):
#   - 카카오: https://developers.kakao.com → 앱 → REST API 키 + [보안] Client Secret(사용 ON)
#             [카카오 로그인] 활성화, Redirect URI: {APP_URL}/api/auth/kakao/callback
#   - 네이버: https://developers.naver.com/apps → 애플리케이션 등록 → Client ID/Secret
#             Callback URL: {APP_URL}/api/auth/naver/callback
APP_URL=http://localhost:3000
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=
# 카카오 동의항목(scope). 기본 profile_nickname. 이메일도 받으려면 비즈앱 등록 후 "profile_nickname,account_email"
KAKAO_SCOPE=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# 관리자 카드 임포트 — 외부 Cutie Card 분석기 API (서버 전용)
CUTIE_CARD_API_BASE=https://card.taba.asia
CUTIE_CARD_API_KEY=

# 매입일 기준 JPY→KRW 환율 조회 (Frankfurter/ECB, API 키 불필요)
FX_API_BASE=https://api.frankfurter.dev/v1

# 웹 푸시 (VAPID) — `npx web-push generate-vapid-keys`로 생성. 미설정 시 푸시만 비활성(인앱 알림은 동작).
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
