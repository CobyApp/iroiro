# Phase 1: MinIO local storage
R2_ENDPOINT=http://localhost:9000
# 서명 리전 — 로컬 MinIO/R2는 auto, AWS S3는 버킷 리전(ap-northeast-1)
R2_REGION=auto
R2_ACCESS_KEY_ID=minioadmin
R2_SECRET_ACCESS_KEY=minioadmin
R2_BUCKET=iroiro-products-dev
R2_PUBLIC_BASE=http://localhost:9000/iroiro-products-dev
# UGC 사진 전용 비공개 버킷 — 공개 도메인 연결 금지(서명 GET만으로 서빙)
# 자격증명은 위 R2_*를 공유한다 — 운영 토큰 스코프에 이 버킷도 포함할 것
R2_UGC_BUCKET=iroiro-ugc-dev

# 결제 게이트웨이 어댑터 (기본 mock). 실 PG 연동 시 "toss" 등으로 교체 + 해당 시크릿 추가.
PAYMENT_PROVIDER=mock

# Prisma 직접 연결 — 비특권 `app` 롤로 접속한다(GRANT 매트릭스가 DB 방어선).
#   소유자 postgres로 붙으면 GRANT가 무효라 soft delete 강제 등이 작동하지 않는다.
# 로컬: compose.yml의 postgres 컨테이너. `npm run db:reset`이 db/schema.sql 적용 + app 롤 LOGIN 부여
# 운영(AWS RDS 등): db/schema.sql을 소유자로 적용 후 `ALTER ROLE app WITH LOGIN PASSWORD '...'` 1회 실행,
#   접속 문자열의 userinfo를 app:<비밀번호>로
DATABASE_URL=postgresql://app:app@127.0.0.1:5432/iroiro

# 카탈로그 DB — 토레카 마스터(그룹·멤버·시리즈·종류·카드). dev·prd 가 **같은 DB 하나**를 공유한다.
# 로컬: compose.yaml 의 postgres 안 iroiro_catalog (docker/initdb 가 생성, db:reset 이 db/catalog-schema.sql 적용)
# 운영: 운영 RDS 안 별도 DB, 비특권 catalog_app 롤. 값은 SSM /iroiro/<env>/CATALOG_DATABASE_URL
CATALOG_DATABASE_URL=postgresql://catalog_app:app@127.0.0.1:5432/iroiro_catalog
# 카탈로그 이미지 버킷(dev·prd 공유) — cards/wm/ 만 공개, cards/clean/ 은 비공개(관리자 라우트로 프록시)
CATALOG_BUCKET=iroiro-catalog-dev
CATALOG_PUBLIC_BASE=http://localhost:9000/iroiro-catalog-dev

# OAuth 소셜 로그인 (자체 인증 — 카카오·네이버)
# 외부 등록 필요(콘솔에서 Redirect/Callback URI를 아래 경로로 등록):
#   - 카카오: https://developers.kakao.com → 앱 → REST API 키 + [보안] Client Secret(사용 ON)
#             [카카오 로그인] 활성화, Redirect URI: {APP_URL}/api/auth/kakao/callback
#   - 네이버: https://developers.naver.com/apps → 애플리케이션 등록 → Client ID/Secret
#             Callback URL: {APP_URL}/api/auth/naver/callback
APP_URL=http://localhost:3000
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=
# 카카오 동의항목(scope). 기본 profile_nickname. 이메일도 받으려면 비즈앱 등록 후 "profile_nickname,account_email"
KAKAO_SCOPE=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# 매입일 기준 JPY→KRW 환율 조회 (Frankfurter/ECB, API 키 불필요)
FX_API_BASE=https://api.frankfurter.dev/v1

# 카드 이미지 분석 — AWS Bedrock Titan Multimodal Embeddings (서버 전용)
# 카드 등록 시 앞면 이미지를 임베딩해 "유사 카드 찾기"·중복 감지에 쓴다.
# 리전만 채우면 활성화되고, 비어 있으면 분석만 조용히 건너뛴다(등록 자체는 정상 동작).
# 이미지 임베딩 모델(titan-embed-image-v1)은 us-east-1 등에만 있으니 리전 주의(서울엔 없음).
BEDROCK_REGION=
# 자격증명은 (1) 아래 정적 키가 있으면 그것, 없으면 (2) AWS 자격증명 체인에서 해석한다.
#   - 로컬: BEDROCK_PROFILE에 ~/.aws 프로필 이름을 넣으면 그 프로필의 키를 자동 사용(시크릿 미기재).
#   - 운영(ECS): 셋 다 비우고 태스크 IAM 역할을 사용.
BEDROCK_ACCESS_KEY_ID=
BEDROCK_SECRET_ACCESS_KEY=
BEDROCK_PROFILE=
# 임베딩 모델·차원(선택 — 기본값 사용 가능)
BEDROCK_EMBED_MODEL_ID=amazon.titan-embed-image-v1
BEDROCK_EMBED_DIMENSION=1024

# 웹 푸시 (VAPID) — `npx web-push generate-vapid-keys`로 생성. 미설정 시 푸시만 비활성(인앱 알림은 동작).
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
