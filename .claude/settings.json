{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "sh ./scripts/claude-precommit-check.sh",
            "if": "Bash(git commit *)"
          },
          {
            "type": "command",
            "command": "sh ./scripts/claude-prelint-check.sh",
            "if": "Bash(git commit *)",
            "timeout": 120
          },
          {
            "type": "command",
            "command": "sh ./scripts/claude-security-check.sh",
            "if": "Bash(git commit *)",
            "timeout": 120
          }
        ]
      }
    ]
  }
}
